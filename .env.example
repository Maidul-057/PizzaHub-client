# Express API base URL (include /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# MongoDB (use the SAME database as the Express server)
MONGODB_URI=
DB_NAME=pizzahub

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB (server-side only, used by /api/upload)
IMGBB_API_KEY=

# Only used by scripts/seed-admin.mjs
ADMIN_NAME=PizzaHub Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
